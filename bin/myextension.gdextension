[configuration]

entry_symbol = "myextension_library_init"
compatibility_minimum = "4.1"
reloadable = false

[libraries]

macos.debug = "./libmyextension.macos.template_debug.dev.dylib"
macos.release = "./libmyextension.macos.template_release.dylib"
windows.debug.x86_32 = "./gdgdextension.windows.template_debug.dev.x86_32.dll"
windows.release.x86_32 = "./gdgdextension.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "./gdgdextension.windows.template_debug.dev.x86_64.dll"
windows.release.x86_64 = "./gdgdextension.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./libmyextension.linux.template_debug.dev.x86_64.so"
linux.release.x86_64 = "./libmyextension.linux.template_release.x86_64.so"
linux.debug.arm64 = "./libmyextension.linux.template_debug.dev.arm64.so"
linux.release.arm64 = "./libmyextension.linux.template_release.arm64.so"
linux.debug.rv64 = "./libmyextension.linux.template_debug.dev.rv64.so"
linux.release.rv64 = "./libmyextension.linux.template_release.rv64.so"